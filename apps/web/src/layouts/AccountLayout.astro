---
import BaseLayout from './BaseLayout.astro';
import AccountNav, { ACCOUNT_NAV_ITEMS } from '../components/AccountNav.tsx';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { buildAccountBreadcrumbs, type BreadcrumbItem } from '../lib/breadcrumbs';

interface Props {
  title: string;
  heading: string;
  description?: string;
  currentPath: string;
  breadcrumbTail?: BreadcrumbItem[];
}

const { title, heading, description, currentPath, breadcrumbTail = [] } = Astro.props;

const currentNavItem = ACCOUNT_NAV_ITEMS.find(
  (item) => currentPath === item.href || currentPath.startsWith(`${item.href}/`)
);
const isRoot = currentPath === '/dashboard';
const breadcrumbItems = buildAccountBreadcrumbs({
  currentPath,
  heading,
  sectionHref: currentNavItem?.href,
  sectionLabel: currentNavItem?.label,
  tail: breadcrumbTail,
});
---

<BaseLayout title={title}>
  <div class="border-b border-[var(--color-border)] bg-[var(--color-surface)]">
    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6">
      <Breadcrumbs items={breadcrumbItems} />

      <!-- Page heading -->
      <div>
        <h1 class="font-display text-2xl font-bold text-[var(--color-ink)] sm:text-3xl">{heading}</h1>
        {description && <p class="mt-1.5 max-w-2xl text-sm text-[var(--color-ink-muted)]">{description}</p>}
      </div>

    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    {isRoot ? (
      <slot />
    ) : (
      <div class="grid gap-10 md:grid-cols-[240px_minmax(0,1fr)]">
        <aside class="hidden md:block md:sticky md:top-24 md:self-start">
          <AccountNav client:load currentPath={currentPath} />
        </aside>
        <div class="min-w-0">
          <slot />
        </div>
      </div>
    )}
  </div>
</BaseLayout>
