---
import BaseLayout from './BaseLayout.astro';
import { GUIDES, GUIDE_CATEGORIES, type Guide } from '../lib/guides';
import {
  buildGuideArticleJsonLd,
  buildGuideBreadcrumbJsonLd,
  formatGuideDate,
  guideUrl,
  sectionAnchorId,
  toIsoDateTime,
} from '../lib/guide-seo';
import { NEIGHBORHOOD_LABELS, type BerlinNeighborhood } from '../types/listing';

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const related = guide.relatedSlugs
  .map((slug) => GUIDES.find((g) => g.slug === slug))
  .filter(Boolean) as Guide[];

const modifiedAt = guide.updatedAt ?? guide.publishedAt;
const pageTitle = `${guide.title} — renting.berlin`;
---

<BaseLayout
  title={pageTitle}
  description={guide.description}
  canonical={guideUrl(guide.slug)}
  ogType="article"
  ogEyebrow={GUIDE_CATEGORIES[guide.category]}
  articlePublishedTime={toIsoDateTime(guide.publishedAt)}
  articleModifiedTime={toIsoDateTime(modifiedAt)}
  articleSection={GUIDE_CATEGORIES[guide.category]}
  jsonLd={[buildGuideArticleJsonLd(guide), buildGuideBreadcrumbJsonLd(guide)]}
>
  <div class="border-b border-[var(--color-border)] bg-[var(--color-surface)]">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
      <a href="/guides" class="text-sm font-semibold text-[var(--color-brand)] hover:underline">← All guides</a>
      <p class="mt-4 text-xs font-bold uppercase tracking-widest text-[var(--color-brand)]">
        {GUIDE_CATEGORIES[guide.category]}
      </p>
      <h1 class="mt-1 max-w-3xl font-display text-3xl font-extrabold text-[var(--color-ink)] sm:text-4xl">
        {guide.title}
      </h1>
      <p class="mt-3 max-w-2xl text-[var(--color-ink-muted)]">{guide.description}</p>
      <p class="mt-2 text-xs text-[var(--color-ink-muted)]">
        {guide.readMinutes} min read ·
        <time datetime={guide.publishedAt}>Published {formatGuideDate(guide.publishedAt)}</time>
        {guide.updatedAt && (
          <>
            {' '}· <time datetime={guide.updatedAt}>Updated {formatGuideDate(guide.updatedAt)}</time>
          </>
        )}
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-12">
      <aside class="lg:col-span-3">
        <nav class="sticky top-24 rounded-2xl border border-[var(--color-border)] bg-white p-4">
          <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-ink-muted)]">Guides</p>
          <ul class="mt-3 space-y-1">
            {GUIDES.map((g) => (
              <li>
                <a
                  href={`/guides/${g.slug}`}
                  class:list={[
                    'block rounded-lg px-3 py-2 text-sm transition',
                    g.slug === guide.slug
                      ? 'bg-[var(--color-brand-muted)] font-semibold text-[var(--color-brand-deep)]'
                      : 'text-[var(--color-ink-muted)] hover:bg-[var(--color-paper)] hover:text-[var(--color-ink)]',
                  ]}
                >
                  {g.title.replace(/ — .*/, '')}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>

      <article class="guide-prose lg:col-span-6" itemscope itemtype="https://schema.org/Article">
        <meta itemprop="headline" content={guide.title} />
        <meta itemprop="description" content={guide.description} />
        <meta itemprop="datePublished" content={guide.publishedAt} />
        <meta itemprop="dateModified" content={modifiedAt} />
        {guide.sections.map((section) => (
          <section class="mb-10">
            <h2 id={sectionAnchorId(section.heading)} class="font-display text-xl font-bold text-[var(--color-ink)]">
              {section.heading}
            </h2>
            {section.paragraphs.map((p) => (
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-muted)]">{p}</p>
            ))}
            {section.bullets && (
              <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                {section.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
          </section>
        ))}

        {guide.externalLinks && guide.externalLinks.length > 0 && (
          <div class="mt-10 rounded-2xl border border-[var(--color-border)] bg-[var(--color-paper)] p-5">
            <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-brand)]">Further reading</p>
            <ul class="mt-3 space-y-2">
              {guide.externalLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm font-medium text-[var(--color-brand-deep)] hover:underline"
                  >
                    {link.label} ↗
                  </a>
                </li>
              ))}
            </ul>
            <p class="mt-4 text-xs leading-relaxed text-[var(--color-ink-muted)]">
              External guides are independent resources. renting.berlin is not affiliated with third-party sites.
            </p>
          </div>
        )}
      </article>

      <aside class="lg:col-span-3">
        {related.length > 0 && (
          <div class="rounded-2xl border border-[var(--color-border)] bg-white p-5">
            <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-ink-muted)]">Related</p>
            <ul class="mt-3 space-y-3">
              {related.map((g) => (
                <li>
                  <a href={`/guides/${g.slug}`} class="block text-sm font-semibold text-[var(--color-brand)] hover:underline">
                    {g.title.replace(/ — .*/, '')}
                  </a>
                  <p class="mt-0.5 text-xs text-[var(--color-ink-muted)]">{g.readMinutes} min</p>
                </li>
              ))}
            </ul>
          </div>
        )}
        <div class="mt-4 rounded-2xl bg-gradient-to-br from-[var(--color-brand)] to-[var(--color-brand-deep)] p-5 text-white">
          <p class="font-display font-bold">Ready to search?</p>
          <p class="mt-2 text-sm text-white/85">Browse offers publicly — sign up to contact landlords or save alerts.</p>
          <div class="mt-4 flex flex-col gap-2">
            <a href="/offers" class="rounded-full bg-white px-4 py-2 text-center text-sm font-semibold text-[var(--color-brand-deep)]">
              Browse offers
            </a>
            <a href="/for-landlords" class="rounded-full border border-white/40 px-4 py-2 text-center text-sm font-semibold text-white hover:bg-white/10">
              List your flat
            </a>
          </div>
        </div>
        <div class="mt-4 rounded-2xl border border-[var(--color-border)] bg-white p-5">
          <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-ink-muted)]">By neighborhood</p>
          <ul class="mt-3 space-y-2">
            {(['kreuzberg', 'neukolln', 'prenzlauer-berg', 'friedrichshain'] as BerlinNeighborhood[]).map((slug) => (
              <li>
                <a href={`/rent-in/${slug}`} class="text-sm font-medium text-[var(--color-brand)] hover:underline">
                  Rent in {NEIGHBORHOOD_LABELS[slug]}
                </a>
              </li>
            ))}
          </ul>
          <a href="/guides" class="mt-3 inline-block text-xs font-semibold text-[var(--color-brand)] hover:underline">
            All guides →
          </a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
