---
import AccountLayout from '../layouts/AccountLayout.astro';
import { eq, inArray } from 'drizzle-orm';
import { db } from '../db';
import { favorites, listings } from '../db/schema';
import ListingCard from '../components/ListingCard.tsx';
import { toSummary } from '../lib/search';

export const prerender = false;

const session = Astro.locals.session;
let items: ReturnType<typeof toSummary>[] = [];

if (session) {
  try {
    const favRows = await db.query.favorites.findMany({
      where: eq(favorites.userId, session.user.id),
    });
    const ids = favRows.map((f) => f.listingId);
    if (ids.length > 0) {
      const rows = await db.query.listings.findMany({
        where: inArray(listings.id, ids),
      });
      items = rows.filter((r) => r.status === 'active').map(toSummary);
    }
  } catch {
    // DB unavailable
  }
}
---

<AccountLayout
  title="Favorites — renting.berlin"
  heading="Favorites"
  description="Listings you've saved with the heart icon."
  currentPath="/favorites"
>
  {items.length > 0 ? (
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((listing) => (
        <ListingCard client:load listing={listing} />
      ))}
    </div>
  ) : (
    <div class="mx-auto mt-8 max-w-sm rounded-2xl border-2 border-dashed border-[var(--color-border)] bg-[var(--color-brand-muted)] px-6 py-16 text-center">
      <div class="mx-auto mb-5 flex size-16 items-center justify-center rounded-full bg-white shadow-[var(--shadow-card)]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-7 text-[var(--color-brand)]">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
        </svg>
      </div>
      <p class="font-display text-xl font-bold text-[var(--color-brand-deep)]">No favorites yet</p>
      <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)]">
        Save listings you like by tapping the heart icon — they'll appear here.
      </p>
      <a href="/offers" class="btn-brand mt-6">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
          <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" />
        </svg>
        Browse listings
      </a>
    </div>
  )}
</AccountLayout>
