---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ListingForm from '../../components/ListingForm.tsx';
import { buildAccountBreadcrumbs } from '../../lib/breadcrumbs';

export const prerender = false;

const breadcrumbItems = buildAccountBreadcrumbs({
  currentPath: '/listings/new',
  heading: 'Publish a listing',
});
---

<BaseLayout title="Publish a listing — renting.berlin">
  <div class="border-b border-[var(--color-border)] bg-[var(--color-surface)]">
    <div class="mx-auto max-w-3xl px-4 py-6 sm:px-6">
      <Breadcrumbs items={breadcrumbItems} />
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-brand)]">Angebote · Offers</p>
      <h1 class="mt-1 font-display text-2xl font-bold text-[var(--color-ink)] sm:text-3xl">Publish a listing</h1>
      <p class="mt-1.5 text-sm text-[var(--color-ink-muted)]">List your flat or room in Berlin. All fields can be edited after publishing.</p>
    </div>
  </div>

  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <ListingForm client:load />
  </div>
</BaseLayout>
