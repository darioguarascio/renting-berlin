---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GUIDES, GUIDE_CATEGORIES } from '../../lib/guides';
import { buildGuidesIndexJsonLd, guidesIndexUrl } from '../../lib/guide-seo';
import { BERLIN_NEIGHBORHOODS, NEIGHBORHOOD_LABELS, type BerlinNeighborhood } from '../../types/listing';

const categories = Object.entries(GUIDE_CATEGORIES) as [keyof typeof GUIDE_CATEGORIES, string][];
const featuredNeighborhoods: BerlinNeighborhood[] = ['kreuzberg', 'neukolln', 'prenzlauer-berg', 'friedrichshain', 'mitte', 'charlottenburg'];
const pageTitle = 'Berlin rental guides — renting.berlin';
const pageDescription =
  'Practical guides on Anmeldung, SCHUFA, rent costs, tenant rights, and finding a flat in Berlin.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={guidesIndexUrl()}
  jsonLd={buildGuidesIndexJsonLd(GUIDES)}
>
  <div class="border-b border-[var(--color-border)] bg-[var(--color-surface)]">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-brand)]">Knowledge base</p>
      <h1 class="mt-1 font-display text-3xl font-extrabold text-[var(--color-ink)] sm:text-4xl">
        Berlin rental guides
      </h1>
      <p class="mt-3 max-w-2xl text-[var(--color-ink-muted)]">
        Practical guides for Berliners — Anmeldung, SCHUFA, costs, documents, and how to search smarter on renting.berlin.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    {categories.map(([key, label]) => {
      const items = GUIDES.filter((g) => g.category === key);
      if (items.length === 0) return null;
      return (
        <section class="mb-12">
          <h2 class="font-display text-lg font-bold text-[var(--color-ink)]">{label}</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {items.map((guide) => (
              <a
                href={`/guides/${guide.slug}`}
                class="card group p-5 transition hover:-translate-y-0.5 hover:border-[var(--color-brand)] hover:shadow-[var(--shadow-float)]"
              >
                <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-brand)]">
                  {guide.readMinutes} min read
                </p>
                <h3 class="mt-2 font-display text-base font-bold leading-snug text-[var(--color-ink)] group-hover:text-[var(--color-brand-deep)]">
                  {guide.title}
                </h3>
                <p class="mt-2 line-clamp-3 text-sm text-[var(--color-ink-muted)]">{guide.description}</p>
              </a>
            ))}
          </div>
        </section>
      );
    })}

    <section class="mb-12">
      <h2 class="font-display text-lg font-bold text-[var(--color-ink)]">Rent by neighborhood</h2>
      <p class="mt-1 text-sm text-[var(--color-ink-muted)]">Market stats and live listings for Berlin Kieze.</p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {featuredNeighborhoods.map((slug) => (
          <a
            href={`/rent-in/${slug}`}
            class="card group flex items-center justify-between px-5 py-4 transition hover:-translate-y-0.5 hover:border-[var(--color-brand)]"
          >
            <span class="font-display font-bold text-[var(--color-ink)] group-hover:text-[var(--color-brand-deep)]">
              Rent in {NEIGHBORHOOD_LABELS[slug]}
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 text-[var(--color-ink-muted)]">
              <path stroke-linecap="round" stroke-linejoin="round" d="m5.75 12.5 4.5-4.5-4.5-4.5" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <div class="rounded-2xl border border-dashed border-[var(--color-border)] bg-[var(--color-paper)] px-6 py-8 text-center">
      <p class="text-sm text-[var(--color-ink-muted)]">
        Want more depth on bureaucracy, taxes, or insurance in Germany?
      </p>
      <a
        href="https://www.settle-in-berlin.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-block text-sm font-semibold text-[var(--color-brand)] hover:underline"
      >
        Settle in Berlin — expat guides since 2011 ↗
      </a>
    </div>
  </div>
</BaseLayout>
