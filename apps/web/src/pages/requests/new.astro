---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeekerRequestForm from '../../components/SeekerRequestForm.tsx';

export const prerender = false;
---

<BaseLayout title="Post seeker profile — renting.berlin">
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent)]">Gesuche · Requests</p>
    <h1 class="mt-1 font-display text-3xl font-extrabold text-[var(--color-ink)]">Post your seeker profile</h1>
    <p class="mt-2 text-[var(--color-ink-muted)]">
      Let landlords find you. All details are optional — the more you share, the better for owners reviewing your profile.
    </p>
    <div class="mt-8">
      <SeekerRequestForm client:load />
    </div>
  </div>
</BaseLayout>
