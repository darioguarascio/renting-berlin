---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RequestsSearchPage from '../../components/RequestsSearchPage.tsx';
import { searchTenantRequests, parseHouseholdTypesParam } from '../../lib/tenant-requests';
import { prepareSeekerDisplayRows } from '../../lib/seeker-profile-visibility';
import { resolveSearchView, SEARCH_VIEW_COOKIE } from '../../lib/search-view-preference';
import type { TenantRequestFilters } from '../../lib/tenant-requests';

export const prerender = false;

const params = Astro.url.searchParams;
const filters: TenantRequestFilters = {
  category: (params.get('category') as TenantRequestFilters['category']) ?? undefined,
  rentType: (params.get('rentType') as TenantRequestFilters['rentType']) ?? undefined,
  neighborhood: params.get('neighborhood') ?? undefined,
  minBudget: params.get('minBudget') ? Number(params.get('minBudget')) : undefined,
  maxBudget: params.get('maxBudget') ? Number(params.get('maxBudget')) : undefined,
  anmeldungNeeded: params.get('anmeldungNeeded') === 'true' ? true : undefined,
  hasSchufa: params.get('hasSchufa') === 'true' ? true : undefined,
  householdTypes: parseHouseholdTypesParam(params),
  page: params.get('page') ? Number(params.get('page')) : 1,
  limit: 12,
  sort: params.get('sort') === 'updated' ? 'updated' : undefined,
};

const viewParam = params.get('view');
const session = Astro.locals.session;
const savedView = session ? Astro.cookies.get(SEARCH_VIEW_COOKIE.requests)?.value : undefined;
const view = resolveSearchView(viewParam, 'requests', savedView);

let result = { items: [], total: 0, page: 1, limit: 12, totalPages: 1 };
let displayRows = [];

try {
  result = await searchTenantRequests(filters);
  displayRows = await prepareSeekerDisplayRows(
    result.items,
    session ? { id: session.user.id } : null,
  );
} catch {
  // DB may not be running
}
---

<BaseLayout title="Tenant requests in Berlin — renting.berlin">
  <RequestsSearchPage
    client:load
    initialFilters={filters}
    result={result}
    displayRows={displayRows}
    view={view}
    isAuthenticated={!!session}
    loginRedirect={Astro.url.pathname + Astro.url.search}
  />
</BaseLayout>
