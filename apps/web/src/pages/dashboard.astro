---
import AccountLayout from '../layouts/AccountLayout.astro';
import { getUserHandle } from '../lib/user-handle';

export const prerender = false;

const session = Astro.locals.session;
const firstName = session?.user?.name?.split(' ')[0] ?? '';
const handle = session?.user?.id ? await getUserHandle(session.user.id) : null;
const heading = firstName ? `Good to see you, ${firstName}` : 'My account';
const description = handle
  ? `@${handle} — your account overview.`
  : 'Your account overview.';

const sections = [
  {
    heading: 'Your content',
    links: [
      { href: '/account/listings', title: 'My listings', desc: 'Publish, edit or deactivate your offers', icon: 'listings' },
      { href: '/requests/new', title: 'Post seeker profile', desc: 'Let landlords find you', icon: 'requests' },
      { href: '/account/profile-views', title: 'Profile views', desc: 'Who viewed your seeker profile', icon: 'profile-views' },
    ],
  },
  {
    heading: 'Activity',
    links: [
      { href: '/messages', title: 'Messages', desc: 'Landlord & tenant conversations', icon: 'messages', accent: true },
      { href: '/favorites', title: 'Favorites', desc: 'Saved listings', icon: 'favorites' },
      { href: '/saved-searches', title: 'Saved searches', desc: 'Alerts for new matches', icon: 'saved-searches' },
    ],
  },
  {
    heading: 'Account',
    links: [
      { href: '/account/settings', title: 'Settings', desc: 'Profile, sign out & preferences', icon: 'settings' },
      { href: '/account/notifications', title: 'Notifications', desc: 'Alerts & contact settings', icon: 'notifications' },
    ],
  },
];

const icons: Record<string, string> = {
  listings: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M11.47 3.841a.75.75 0 0 1 1.06 0l8.69 8.69a.75.75 0 1 0 1.06-1.061l-8.689-8.69a2.25 2.25 0 0 0-3.182 0l-8.69 8.69a.75.75 0 1 0 1.061 1.06l8.69-8.689Z"/><path d="m12 5.432 8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 0 1-.75-.75v-4.5a.75.75 0 0 0-.75-.75h-3a.75.75 0 0 0-.75.75V21a.75.75 0 0 1-.75.75H5.625a1.875 1.875 0 0 1-1.875-1.875v-6.198a2.29 2.29 0 0 0 .091-.086L12 5.432Z"/></svg>`,
  requests: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M8.25 6.75a3.75 3.75 0 1 1 7.5 0 3.75 3.75 0 0 1-7.5 0ZM15.75 9.75a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM2.25 9.75a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM6.31 15.117A6.745 6.745 0 0 1 12 12a6.745 6.745 0 0 1 6.709 7.498.75.75 0 0 1-.632.502H6.96a.75.75 0 0 1-.65-.883ZM12 14.25a4.5 4.5 0 0 0-4.08 2.592h8.16A4.5 4.5 0 0 0 12 14.25Z" clip-rule="evenodd"/></svg>`,
  'profile-views': `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path fill-rule="evenodd" d="M1.323 11.447C2.811 6.976 7.028 3.75 12.001 3.75c4.97 0 9.185 3.223 10.675 7.69.12.362.12.752 0 1.113-1.487 4.471-5.705 7.697-10.677 7.697-4.97 0-9.186-3.223-10.675-7.69a1.762 1.762 0 0 1 0-1.113ZM17.25 12a5.25 5.25 0 1 1-10.5 0 5.25 5.25 0 0 1 10.5 0Z" clip-rule="evenodd"/></svg>`,
  settings: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M11.078 2.25c-.917 0-1.699.663-1.85 1.567L9.05 4.889c-.02.12-.115.26-.297.348a7.493 7.493 0 0 0-.986.57c-.166.115-.334.126-.45.083L6.3 5.508a1.875 1.875 0 0 0-2.282.819l-.922 1.597a1.875 1.875 0 0 0 .432 2.385l.84.692c.095.078.17.229.154.43a7.598 7.598 0 0 0 0 2.936c.016.2-.059.352-.153.43l-.841.692a1.875 1.875 0 0 0-.432 2.385l.922 1.597a1.875 1.875 0 0 0 2.282.818l1.019-.382c.115-.043.283-.031.45.082.312.214.641.405.985.57.182.088.277.228.297.348l.178 1.071c.151.904.933 1.567 1.85 1.567h1.844c.916 0 1.699-.663 1.85-1.567l.178-1.072c.02-.12.114-.26.297-.349.344-.165.673-.356.985-.57.167-.114.335-.125.45-.082l1.02.382a1.875 1.875 0 0 0 2.28-.819l.923-1.597a1.875 1.875 0 0 0-.432-2.385l-.84-.692c-.095-.078-.17-.229-.154-.43a7.606 7.606 0 0 0 0-2.936c-.016-.2.059-.352.153-.43l.84-.692c.708-.582.891-1.59.433-2.385l-.922-1.597a1.875 1.875 0 0 0-2.282-.818l-1.02.382c-.114.043-.282.031-.449-.083a7.49 7.49 0 0 0-.985-.57c-.183-.087-.277-.227-.297-.348l-.179-1.072a1.875 1.875 0 0 0-1.85-1.567h-1.843ZM12 15.75a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Z" clip-rule="evenodd"/></svg>`,
  notifications: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M5.25 9a6.75 6.75 0 0 1 13.5 0v.75c0 2.123.8 4.057 2.118 5.52a.75.75 0 0 1-.297 1.206c-1.544.57-3.16.99-4.831 1.123A3.75 3.75 0 0 1 12 21.75a3.75 3.75 0 0 1-2.24-.752 8.962 8.962 0 0 1-4.83-1.123.75.75 0 0 1-.298-1.205A6.75 6.75 0 0 1 5.25 9Zm4.502 8.135a7.454 7.454 0 0 0 2.252 0 7.454 7.454 0 0 0 2.252 0 8.962 8.962 0 0 1-4.504 0Z" clip-rule="evenodd"/></svg>`,
  'saved-searches': `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M10.5 3.75a6.75 6.75 0 1 0 0 13.5 6.75 6.75 0 0 0 0-13.5ZM2.25 10.5a8.25 8.25 0 1 1 14.59 5.28l4.69 4.69a.75.75 0 1 1-1.06 1.06l-4.69-4.69A8.25 8.25 0 0 1 2.25 10.5Z" clip-rule="evenodd"/></svg>`,
  favorites: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z"/></svg>`,
  messages: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M4.848 2.771A49.144 49.144 0 0 1 12 2.25c2.43 0 4.817.178 7.152.52 1.978.292 3.348 2.024 3.348 3.97v6.02c0 1.946-1.37 3.678-3.348 3.97a48.901 48.901 0 0 1-3.476.383.39.39 0 0 0-.297.17l-2.755 4.133a.75.75 0 0 1-1.248 0l-2.755-4.133a.39.39 0 0 0-.297-.17 48.9 48.9 0 0 1-3.476-.384c-1.978-.29-3.348-2.024-3.348-3.97V6.741c0-1.946 1.37-3.68 3.348-3.97Z" clip-rule="evenodd"/></svg>`,
};
---

<AccountLayout
  title="Dashboard — renting.berlin"
  heading={heading}
  description={description}
  currentPath="/dashboard"
>
  <div class="space-y-10">
    {sections.map((section) => (
      <section>
        <h2 class="text-xs font-bold uppercase tracking-widest text-[var(--color-ink-muted)]">{section.heading}</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
          {section.links.map((link) => (
            <a href={link.href} class="feature-row card group px-5 py-4 transition hover:border-[var(--color-brand)]">
              <span class={`link-row__icon${link.accent ? ' link-row__icon--accent' : ''}`} aria-hidden="true" set:html={icons[link.icon]} />
              <div class="min-w-0 flex-1">
                <span class="link-row__title">{link.title}</span>
                <p class="link-row__desc">{link.desc}</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" class="link-row__chevron ml-auto mt-0.5 size-4 shrink-0 group-hover:opacity-100" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m5.75 12.5 4.5-4.5-4.5-4.5" />
              </svg>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</AccountLayout>
