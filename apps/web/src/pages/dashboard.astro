---
import AccountLayout from '../layouts/AccountLayout.astro';

export const prerender = false;

const session = Astro.locals.session;
const firstName = session?.user?.name?.split(' ')[0] ?? '';
const heading = firstName ? `Good to see you, ${firstName}` : 'My account';
---

<AccountLayout
  title="Dashboard — renting.berlin"
  heading={heading}
  description="What would you like to do today?"
  currentPath="/dashboard"
>
  <!-- Primary paths -->
  <div class="grid gap-4 sm:grid-cols-2">

    <!-- Landlord path -->
    <a href="/listings/new" class="group flex flex-col gap-5 rounded-2xl border border-[var(--color-brand-muted)] bg-gradient-to-br from-[var(--color-brand-muted)] to-[var(--color-surface)] p-6 transition duration-200 hover:border-[var(--color-brand)] hover:shadow-[var(--shadow-float)]">
      <div class="flex size-12 items-center justify-center rounded-xl bg-[var(--color-brand)] text-white shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
          <path d="M11.47 3.841a.75.75 0 0 1 1.06 0l8.69 8.69a.75.75 0 1 0 1.06-1.061l-8.689-8.69a2.25 2.25 0 0 0-3.182 0l-8.69 8.69a.75.75 0 1 0 1.061 1.06l8.69-8.689Z" />
          <path d="m12 5.432 8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 0 1-.75-.75v-4.5a.75.75 0 0 0-.75-.75h-3a.75.75 0 0 0-.75.75V21a.75.75 0 0 1-.75.75H5.625a1.875 1.875 0 0 1-1.875-1.875v-6.198a2.29 2.29 0 0 0 .091-.086L12 5.432Z" />
        </svg>
      </div>
      <div class="flex-1">
        <h2 class="font-display text-lg font-bold text-[var(--color-ink)]">List a place</h2>
        <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-ink-muted)]">
          Publish a room or flat and reach verified international tenants across Berlin.
        </p>
      </div>
      <div class="flex items-center justify-between">
        <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-brand)] group-hover:underline">
          Create listing
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="size-3.5 transition-transform group-hover:translate-x-0.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m5.75 12.5 4.5-4.5-4.5-4.5" />
          </svg>
        </span>
        <a
          href="/account/listings"
          class="text-xs font-medium text-[var(--color-ink-muted)] hover:text-[var(--color-brand)] hover:underline"
          onclick="event.stopPropagation()"
        >
          Manage existing
        </a>
      </div>
    </a>

    <!-- Seeker path -->
    <a href="/requests/new" class="group flex flex-col gap-5 rounded-2xl border border-[var(--color-accent-soft)] bg-gradient-to-br from-[var(--color-accent-soft)] to-[var(--color-surface)] p-6 transition duration-200 hover:border-[var(--color-accent)] hover:shadow-[var(--shadow-float)]">
      <div class="flex size-12 items-center justify-center rounded-xl bg-[var(--color-accent)] text-white shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
          <path fill-rule="evenodd" d="M8.25 6.75a3.75 3.75 0 1 1 7.5 0 3.75 3.75 0 0 1-7.5 0ZM15.75 9.75a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM2.25 9.75a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM6.31 15.117A6.745 6.745 0 0 1 12 12a6.745 6.745 0 0 1 6.709 7.498.75.75 0 0 1-.632.502H6.96a.75.75 0 0 1-.65-.883ZM12 14.25a4.5 4.5 0 0 0-4.08 2.592h8.16A4.5 4.5 0 0 0 12 14.25Z" clip-rule="evenodd" />
        </svg>
      </div>
      <div class="flex-1">
        <h2 class="font-display text-lg font-bold text-[var(--color-ink)]">Find a place</h2>
        <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-ink-muted)]">
          Post your seeker profile and let landlords come to you — describe what you need in Berlin.
        </p>
      </div>
      <div class="flex items-center justify-between">
        <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-accent)] group-hover:underline">
          Post profile
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="size-3.5 transition-transform group-hover:translate-x-0.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m5.75 12.5 4.5-4.5-4.5-4.5" />
          </svg>
        </span>
        <a
          href="/offers"
          class="text-xs font-medium text-[var(--color-ink-muted)] hover:text-[var(--color-accent)] hover:underline"
          onclick="event.stopPropagation()"
        >
          Browse listings
        </a>
      </div>
    </a>
  </div>

  <!-- Activity -->
  <section class="mt-10">
    <h2 class="mb-3 text-xs font-bold uppercase tracking-widest text-[var(--color-ink-muted)]">Activity</h2>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">

      <a href="/messages" class="group flex flex-col items-start gap-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 transition hover:border-[var(--color-accent)] hover:bg-[var(--color-accent-soft)]">
        <span class="flex size-9 items-center justify-center rounded-lg bg-[var(--color-accent-soft)] text-[var(--color-accent)] transition group-hover:bg-white">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
            <path fill-rule="evenodd" d="M2 10c0-3.967 3.69-7 8-7 4.31 0 8 3.033 8 7s-3.69 7-8 7a9.165 9.165 0 0 1-1.504-.123 5.852 5.852 0 0 1-3.935 1.191.75.75 0 0 1-.584-1.143 3.478 3.478 0 0 0 .522-1.756C2.979 13.825 2 12.025 2 10Z" clip-rule="evenodd" />
          </svg>
        </span>
        <div class="min-w-0">
          <p class="font-display text-sm font-bold text-[var(--color-ink)]">Messages</p>
          <p class="text-xs text-[var(--color-ink-muted)]">Conversations</p>
        </div>
      </a>

      <a href="/account/listings" class="group flex flex-col items-start gap-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 transition hover:border-[var(--color-brand)] hover:bg-[var(--color-brand-muted)]">
        <span class="flex size-9 items-center justify-center rounded-lg bg-[var(--color-brand-muted)] text-[var(--color-brand)] transition group-hover:bg-white">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
            <path fill-rule="evenodd" d="M9.293 2.293a1 1 0 0 1 1.414 0l7 7A1 1 0 0 1 17 11h-1v6a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-6H3a1 1 0 0 1-.707-1.707l7-7Z" clip-rule="evenodd" />
          </svg>
        </span>
        <div class="min-w-0">
          <p class="font-display text-sm font-bold text-[var(--color-ink)]">My listings</p>
          <p class="text-xs text-[var(--color-ink-muted)]">Manage offers</p>
        </div>
      </a>

      <a href="/favorites" class="group flex flex-col items-start gap-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 transition hover:border-[var(--color-contrast)] hover:bg-[var(--color-contrast-soft)]">
        <span class="flex size-9 items-center justify-center rounded-lg bg-[var(--color-contrast-soft)] text-[var(--color-contrast)] transition group-hover:bg-white">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
            <path d="m9.653 16.915-.005-.003-.019-.01a20.759 20.759 0 0 1-1.162-.682 22.045 22.045 0 0 1-2.582-2.025C4.045 12.656 2 10.138 2 7.25 2 4.597 4.064 2.5 6.75 2.5c1.255 0 2.451.516 3.25 1.342C10.799 3.016 11.995 2.5 13.25 2.5 15.936 2.5 18 4.597 18 7.25c0 2.888-2.045 5.406-3.885 6.945a22.046 22.046 0 0 1-2.582 2.025 20.757 20.757 0 0 1-1.162.682l-.019.01-.005.003h-.002a.739.739 0 0 1-.69 0l-.002-.001Z" />
          </svg>
        </span>
        <div class="min-w-0">
          <p class="font-display text-sm font-bold text-[var(--color-ink)]">Favorites</p>
          <p class="text-xs text-[var(--color-ink-muted)]">Saved listings</p>
        </div>
      </a>

      <a href="/saved-searches" class="group flex flex-col items-start gap-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 transition hover:border-[var(--color-signal)] hover:bg-[var(--color-signal-soft)]">
        <span class="flex size-9 items-center justify-center rounded-lg bg-[var(--color-signal-soft)] text-[var(--color-signal)] transition group-hover:bg-white">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
            <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" />
          </svg>
        </span>
        <div class="min-w-0">
          <p class="font-display text-sm font-bold text-[var(--color-ink)]">Saved searches</p>
          <p class="text-xs text-[var(--color-ink-muted)]">Search alerts</p>
        </div>
      </a>

    </div>
  </section>

  <!-- Account -->
  <section class="mt-8">
    <h2 class="mb-3 text-xs font-bold uppercase tracking-widest text-[var(--color-ink-muted)]">Account</h2>
    <div class="grid gap-3 sm:grid-cols-3">

      <a href="/account/settings" class="feature-row card group px-5 py-4 transition hover:border-[var(--color-brand)]">
        <span class="link-row__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M11.078 2.25c-.917 0-1.699.663-1.85 1.567L9.05 4.889c-.02.12-.115.26-.297.348a7.493 7.493 0 0 0-.986.57c-.166.115-.334.126-.45.083L6.3 5.508a1.875 1.875 0 0 0-2.282.819l-.922 1.597a1.875 1.875 0 0 0 .432 2.385l.84.692c.095.078.17.229.154.43a7.598 7.598 0 0 0 0 2.936c.016.2-.059.352-.153.43l-.841.692a1.875 1.875 0 0 0-.432 2.385l.922 1.597a1.875 1.875 0 0 0 2.282.818l1.019-.382c.115-.043.283-.031.45.082.312.214.641.405.985.57.182.088.277.228.297.348l.178 1.071c.151.904.933 1.567 1.85 1.567h1.844c.916 0 1.699-.663 1.85-1.567l.178-1.072c.02-.12.114-.26.297-.349.344-.165.673-.356.985-.57.167-.114.335-.125.45-.082l1.02.382a1.875 1.875 0 0 0 2.28-.819l.923-1.597a1.875 1.875 0 0 0-.432-2.385l-.84-.692c-.095-.078-.17-.229-.154-.43a7.606 7.606 0 0 0 0-2.936c-.016-.2.059-.352.153-.43l.84-.692c.708-.582.891-1.59.433-2.385l-.922-1.597a1.875 1.875 0 0 0-2.282-.818l-1.02.382c-.114.043-.282.031-.449-.083a7.49 7.49 0 0 0-.985-.57c-.183-.087-.277-.227-.297-.348l-.179-1.072a1.875 1.875 0 0 0-1.85-1.567h-1.843ZM12 15.75a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Z" clip-rule="evenodd"/></svg>
        </span>
        <div class="min-w-0 flex-1">
          <span class="link-row__title">Settings</span>
          <p class="link-row__desc">Profile &amp; sign out</p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" class="link-row__chevron ml-auto mt-0.5 size-4 shrink-0 group-hover:opacity-100" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m5.75 12.5 4.5-4.5-4.5-4.5" />
        </svg>
      </a>

      <a href="/account/notifications" class="feature-row card group px-5 py-4 transition hover:border-[var(--color-brand)]">
        <span class="link-row__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M5.25 9a6.75 6.75 0 0 1 13.5 0v.75c0 2.123.8 4.057 2.118 5.52a.75.75 0 0 1-.297 1.206c-1.544.57-3.16.99-4.831 1.123A3.75 3.75 0 0 1 12 21.75a3.75 3.75 0 0 1-2.24-.752 8.962 8.962 0 0 1-4.83-1.123.75.75 0 0 1-.298-1.205A6.75 6.75 0 0 1 5.25 9Zm4.502 8.135a7.454 7.454 0 0 0 2.252 0 7.454 7.454 0 0 0 2.252 0 8.962 8.962 0 0 1-4.504 0Z" clip-rule="evenodd"/></svg>
        </span>
        <div class="min-w-0 flex-1">
          <span class="link-row__title">Notifications</span>
          <p class="link-row__desc">Alerts &amp; contact prefs</p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" class="link-row__chevron ml-auto mt-0.5 size-4 shrink-0 group-hover:opacity-100" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m5.75 12.5 4.5-4.5-4.5-4.5" />
        </svg>
      </a>

      <a href="/account/profile-views" class="feature-row card group px-5 py-4 transition hover:border-[var(--color-brand)]">
        <span class="link-row__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path fill-rule="evenodd" d="M1.323 11.447C2.811 6.976 7.028 3.75 12.001 3.75c4.97 0 9.185 3.223 10.675 7.69.12.362.12.752 0 1.113-1.487 4.471-5.705 7.697-10.677 7.697-4.97 0-9.186-3.223-10.675-7.69a1.762 1.762 0 0 1 0-1.113ZM17.25 12a5.25 5.25 0 1 1-10.5 0 5.25 5.25 0 0 1 10.5 0Z" clip-rule="evenodd"/></svg>
        </span>
        <div class="min-w-0 flex-1">
          <span class="link-row__title">Profile views</span>
          <p class="link-row__desc">Who viewed your profile</p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" class="link-row__chevron ml-auto mt-0.5 size-4 shrink-0 group-hover:opacity-100" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m5.75 12.5 4.5-4.5-4.5-4.5" />
        </svg>
      </a>

    </div>
  </section>
</AccountLayout>
