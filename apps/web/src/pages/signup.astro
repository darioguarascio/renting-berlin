---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthForm from '../components/AuthForm.tsx';
import { getEnabledOAuthProviders } from '../lib/auth';

const enabledProviders = getEnabledOAuthProviders();
const turnstileSiteKey = process.env.PUBLIC_TURNSTILE_SITE_KEY ?? import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<BaseLayout title="Sign up — renting.berlin">
  <div class="hero-mesh min-h-[70vh] px-4 py-16 sm:px-6">
    <AuthForm client:load mode="signup" enabledProviders={enabledProviders} turnstileSiteKey={turnstileSiteKey} />
  </div>
</BaseLayout>
