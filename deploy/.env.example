# Production reference for /home/app/.env on rb.main-0
# Copy relevant values to the server .env (never commit real secrets).
#
# App stack (~/docker-compose.yml) and DB stack (~/db/docker-compose.yml) both
# read this file. DB compose uses CLICKHOUSE_PASSWORD from here.

# --- Postgres (container: postgres, app-network) ---
# From app/worker containers prefer the docker hostname:
# DATABASE_URL=postgres://app:YOUR_PG_PASSWORD@postgres:5432/app
# From your laptop via WireGuard use the published host port:
# DATABASE_URL=postgres://app:YOUR_PG_PASSWORD@10.30.0.2:15432/app

# --- Redis (container: redis, app-network) ---
# REDIS_URL=redis://redis:6379/0?socket_timeout=10
# REDIS_URL=redis://10.30.0.2:16379/0?socket_timeout=10

# --- ClickHouse (container: clickhouse, app-network) ---
# Must use docker hostname from app containers — the WG port is for external tools only.
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=renting_berlin
CLICKHOUSE_URL=http://default:YOUR_CLICKHOUSE_PASSWORD@clickhouse:8123

# --- App ---
SITE_URL=https://renting.berlin
BETTER_AUTH_URL=https://renting.berlin
BETTER_AUTH_SECRET=
DOCKER_IMAGE_TAG=dev

# Internal analytics E2E user (no public listings/profile — see scripts/seed-e2e-analytics-user.mjs)
# E2E_ANALYTICS_EMAIL=zanalytics-e2e@renting.berlin
# E2E_ANALYTICS_PASSWORD=
# E2E_ANALYTICS_HANDLE=zanalytics-e2e
