# Copy to .env at the repo root (never commit .env)

# Managed Postgres — full connection string
DATABASE_URL=
TEST_DATABASE_URL=

# Managed Redis — full connection string
REDIS_URL=

# Profile views: set to 1 to upsert directly (tests/local without worker)
# PROFILE_VIEWS_SYNC=1
# PROFILE_VIEW_WORKER_NAME=worker-1

# Auth (required in production)
BETTER_AUTH_SECRET=
# Public URL of the app (use http://localhost:4321 for local Docker)
BETTER_AUTH_URL=http://localhost:4321
# Comma-separated extra origins, e.g. https://staging.example.com
# BETTER_AUTH_TRUSTED_ORIGINS=

# Docker (optional)
# APP_PORT=4321
# DOCKER_IMAGE_TAG=dev

# Optional OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Dev-only one-click login (never enable in production)
PUBLIC_ENABLE_DEV_LOGIN=false
DEV_USER_EMAIL=
DEV_USER_PASSWORD=
DEV_USER_NAME=
DEV_LANDLORD_EMAIL=
DEV_LANDLORD_PASSWORD=
DEV_LANDLORD_NAME=
