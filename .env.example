# Copy to .env at the repo root (never commit .env)

# Managed Postgres — full connection string
DATABASE_URL=
TEST_DATABASE_URL=

# Managed Redis — full connection string
REDIS_URL=

# ClickHouse — analytics (email opens/clicks, profile & listing views)
# CLICKHOUSE_URL=http://10.30.0.2:18123
# CLICKHOUSE_DATABASE=renting_berlin
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=

# Profile views: set to 1 to upsert directly (tests/local without worker)
# PROFILE_VIEWS_SYNC=1
# PROFILE_VIEW_WORKER_NAME=worker-1

# Background workers (Python — see workers/)
# npm run workers:install
# npm run worker:notifications
# npm run worker:emails
# npm run worker:moderation
# npm run worker:profile-views
# npm run worker:telegram
# UPLOADS_DIR=apps/web/public/uploads  (local dev, set automatically by npm scripts)

# Auto-moderation (local ML in Python moderation worker — no LLM API)
# MODERATION_DISABLED=1
# MODERATION_USE_ML=1

# Inline processing for tests/local without Python workers
# NOTIFICATIONS_SYNC=1
# EMAILS_SYNC=1
# MODERATION_SYNC=1
# PROFILE_VIEWS_SYNC=1

# Email (optional — logs to console when SMTP is not configured)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# Telegram group alerts when listings/seeker profiles are published (optional — logs when not configured)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_WORKER_NAME=worker-1
# TELEGRAM_SYNC=1

# Magic-link auth — Cloudflare Turnstile (optional in dev, recommended in prod)
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Auth (required in production)
BETTER_AUTH_SECRET=
# Public URL of the app — required in production (e.g. https://renting.berlin)
# Used for OAuth callbacks and Astro.url behind a reverse proxy
SITE_URL=
# Legacy alias for SITE_URL (either one is enough)
BETTER_AUTH_URL=http://localhost:4321
# Comma-separated extra origins, e.g. https://staging.example.com
# BETTER_AUTH_TRUSTED_ORIGINS=

# APP_PORT=4321
# External listing import (run locally against production DATABASE_URL; not part of deploy)
# EXTERNAL_LISTINGS_EXPORT_PATH=/path/to/listings.json
# DOCKER_IMAGE_TAG=dev
# Images: darioguarascio/renting.berlin (+ -workers for background jobs)
# npm run docker:build && npm run docker:up
# npm run docker:push:workers   # after docker login

# Optional OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Dev-only one-click login (never enable in production)
PUBLIC_ENABLE_DEV_LOGIN=false
DEV_USER_EMAIL=
DEV_USER_PASSWORD=
DEV_USER_NAME=
DEV_LANDLORD_EMAIL=
DEV_LANDLORD_PASSWORD=
DEV_LANDLORD_NAME=
