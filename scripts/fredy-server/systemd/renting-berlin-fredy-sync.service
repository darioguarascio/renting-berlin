[Unit]
Description=Sync Fredy scrape to renting.berlin production
After=renting-berlin-fredy.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@INSTALL_DIR@
Environment=FREDY_ENV=@INSTALL_DIR@/.env
ExecStart=@INSTALL_DIR@/sync.sh
StandardOutput=journal
StandardError=journal
