# Fredy feed server — copy to ~/renting-berlin-fredy/.env

DATABASE_URL=postgres://app:app@10.0.0.11:25432/app

# After deploying apps/web API internal/fredy-sync.ts, set the same secret in prod .env
FREDY_SYNC_URL=https://renting.berlin/api/internal/fredy-sync
FREDY_SYNC_SECRET=change-me

FREDY_URL=http://127.0.0.1:9998
FREDY_USER=admin
FREDY_PASS=admin

# Residential proxy for browser-based providers (Immowelt, WG-Gesucht, …)
# On bmax: join proxies_default network and use mubeng (see docker-compose.yml).
# FREDY_PROXY_NETWORK=proxies_default
# FREDY_PROXY_URL=http://mubeng:8089
FREDY_PROXY_URL=
